NODE_ENV=production
PORT=3000

# MySQL 資料庫（Railway 自動提供）
DATABASE_URL=mysql://user:password@host:3306/railway

# JWT 密鑰（請改為你自己的隨機字串）
JWT_SECRET=your-production-secret-key-change-this

# Cloudflare R2 Storage（收據儲存，可選）
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=taekwondo-receipts
R2_PUBLIC_DOMAIN=

# OpenAI API（收據OCR，可選）
OPENAI_BASE_URL=
OPENAI_API_KEY=
