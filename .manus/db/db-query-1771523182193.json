  "query": "SELECT \n  d.name as dojo_name,\n  d.schedule_day,\n  d.schedule_time,\n  COUNT(s.id) as student_count,\n  SUM(CAST(s.feePerQuarter AS DECIMAL(10,2))) as total_fee\nFROM dojos d\nLEFT JOIN students s ON (\n  s.venue = d.name AND\n  s.scheduleDay = d.schedule_day AND\n  s.scheduleTime = d.schedule_time\n)\nWHERE d.coach_name LIKE '%賴政堡%'\nGROUP BY d.id, d.name, d.schedule_day, d.schedule_time;",
